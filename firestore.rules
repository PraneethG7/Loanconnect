rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /loans/{loanId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.borrowerId == request.auth.uid ||
        resource.data.financierId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.borrowerId == request.auth.uid ||
        request.resource.data.financierId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.borrowerId == request.auth.uid ||
        resource.data.financierId == request.auth.uid
      );
      allow delete: if false;
    }

    match /loan_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.borrowerId == request.auth.uid ||
        resource.data.financierId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.borrowerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.borrowerId == request.auth.uid ||
        resource.data.financierId == request.auth.uid
      );
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.borrowerId == request.auth.uid ||
        resource.data.financierId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.borrowerId == request.auth.uid ||
        request.resource.data.financierId == request.auth.uid
      );
      allow update, delete: if false;
    }
  }
}
