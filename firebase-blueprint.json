{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and role details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "businessName": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "name", "email", "role"]
    },
    "Loan": {
      "title": "Loan",
      "description": "Active or completed loan entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "borrowerId": { "type": "string" },
        "financierId": { "type": "string" },
        "borrowerName": { "type": "string" },
        "financierName": { "type": "string" },
        "principalAmount": { "type": "number" },
        "durationMonths": { "type": "number" },
        "purpose": { "type": "string" },
        "interestRate": { "type": "number" },
        "totalPayable": { "type": "number" },
        "totalPaid": { "type": "number" },
        "status": { "type": "string" },
        "nextDueDate": { "type": "string" },
        "nextInstallmentAmount": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "borrowerId", "financierId", "principalAmount", "durationMonths", "purpose"]
    },
    "LoanRequest": {
      "title": "LoanRequest",
      "description": "Application or request for a loan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "borrowerId": { "type": "string" },
        "financierId": { "type": "string" },
        "requestedAmount": { "type": "number" },
        "durationMonths": { "type": "number" },
        "purpose": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "borrowerId", "requestedAmount", "durationMonths", "purpose"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Recorded repayment transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loanId": { "type": "string" },
        "borrowerId": { "type": "string" },
        "financierId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "paymentDate": { "type": "number" }
      },
      "required": ["id", "loanId", "borrowerId", "amount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents"
    },
    "/loans/{loanId}": {
      "schema": { "$ref": "#/entities/Loan" },
      "description": "Loan records shared between borrower and financier"
    },
    "/loan_requests/{requestId}": {
      "schema": { "$ref": "#/entities/LoanRequest" },
      "description": "Loan application requests"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Repayment transaction history"
    }
  }
}
